# communico dev environment — copy to .env: `cp .env.example .env`
# The real environment wins over this file (pinned by tests/env-precedence.test.ts).
# Container images take their values from ENV, never from a file.

# Matrix homeserver
APP_PORT=8008
SERVER_NAME=localhost

# Doltgres (db-start / the room + tenant engines)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASS=secret
DB_NAME=postgres