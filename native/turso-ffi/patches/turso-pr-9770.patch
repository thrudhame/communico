From 9d51b3d452d8a883563ddd45c9dec3f5220fd844 Mon Sep 17 00:00:00 2001
From: Cole Robertson <cole@colerobertson.dev>
Date: Fri, 9 Oct 2026 17:13:39 -0500
Subject: [PATCH] core/mvcc: complete an interrupted TRUNCATE checkpoint when
 the log is empty

A TRUNCATE checkpoint truncates the logical log (step 8) before it truncates
the WAL (step 10). A process killed between the two leaves a committed WAL and
a 0-byte log. Recovery classified that as case 2 ("WAL has committed frames but
logical log header is missing") and failed closed, so the database could never
be opened again, although the main file was already fully backfilled and the
WAL holds everything the log did.

Treat NoLog + committed WAL like the passive-checkpoint steady state: complete
the checkpoint (backfill, fsync, fresh log header, truncate WAL).

Adds test_bootstrap_recovers_truncate_checkpoint_killed_before_wal_truncate,
which fails without this change. Same root cause as #7480.
---
 core/mvcc/database/mod.rs                     | 15 +++---
 core/mvcc/database/tests.rs                   | 52 +++++++++++++++++++
 docs/internals/mvcc/RECOVERY_SEMANTICS.md     |  2 +-
 .../simulator/runner/memory/mvcc_recovery.rs  | 21 ++++++--
 4 files changed, 77 insertions(+), 13 deletions(-)

diff --git a/core/mvcc/database/mod.rs b/core/mvcc/database/mod.rs
index b543481..e204260 100644
--- a/core/mvcc/database/mod.rs
+++ b/core/mvcc/database/mod.rs
@@ -8935,13 +8935,14 @@ impl<Clock: LogicalClock, A: ConcurrentAllocator> MvStore<Clock, A> {
                             self.storage.set_header(header);
                         }
                         HeaderReadResult::NoLog => {
-                            if !connection.experimental_mvcc_passive_checkpoint_enabled() {
-                                return Err(LimboError::Corrupt(
-                                    "WAL has committed frames but logical log header is missing"
-                                        .to_string(),
-                                )
-                                .into());
-                            }
+                            // Committed WAL + empty/absent log. Passive checkpoints leave
+                            // this as their steady state. A TRUNCATE checkpoint leaves it
+                            // too when the process dies between truncating the logical log
+                            // (step 8) and truncating the WAL (step 10): the log is only
+                            // truncated to 0 once every frame in it is at or below the
+                            // boundary committed to the WAL, so the WAL holds everything
+                            // the log did. Completing the checkpoint loses nothing; failing
+                            // closed made the database permanently unopenable (#7480).
                         }
                         HeaderReadResult::Invalid => {
                             // Present but undecodable: a torn header write / genuine
diff --git a/core/mvcc/database/tests.rs b/core/mvcc/database/tests.rs
index 9d94d08..74b6cc7 100644
--- a/core/mvcc/database/tests.rs
+++ b/core/mvcc/database/tests.rs
@@ -3232,6 +3232,58 @@ fn test_bootstrap_recovers_committed_wal_without_log_file() {
     assert_eq!(rows[0][1].to_string(), "x");
 }
 
+/// A TRUNCATE checkpoint truncates the logical log (step 8) before it truncates the WAL
+/// (step 10). A process killed between the two leaves a committed WAL and a 0-byte log.
+/// Every frame the log held is at or below the boundary committed to the WAL, so recovery
+/// must complete the checkpoint, not fail closed with "logical log header is missing"
+/// (#7480). Passive checkpoints stay OFF here: this is the default-mode crash window.
+#[test]
+fn test_bootstrap_recovers_truncate_checkpoint_killed_before_wal_truncate() {
+    let db = MvccTestDbNoConn::new_with_random_db();
+    let db_path = db.path.as_ref().unwrap().clone();
+    {
+        let conn = db.connect();
+        conn.execute("CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT)")
+            .unwrap();
+        for i in 0..50 {
+            conn.execute(format!("INSERT INTO t VALUES ({i}, 'v{i}')"))
+                .unwrap();
+        }
+        let mvcc_store = db.get_mvcc_store();
+        // Stop right after the pager commit: the WAL holds the committed frames.
+        advance_checkpoint_until_wal_has_commit_frame(mvcc_store.clone(), &conn);
+        // The crash window: logical log already truncated to 0, WAL not yet truncated.
+        let log_file = mvcc_store.get_logical_log_file();
+        let c = log_file.truncate(0, Completion::new_trunc(|_| {})).unwrap();
+        conn.db.io.wait_for_completion(c).unwrap();
+    }
+    let wal_path = wal_path_for_db(&db_path);
+    assert!(wal_path.metadata().map(|m| m.len()).unwrap_or(0) > 0);
+
+    {
+        let mut manager = DATABASE_MANAGER.lock();
+        manager.clear();
+    }
+    let io = Arc::new(PlatformIO::new().unwrap());
+    let db2 = Database::open_file(io, &db_path, Arc::new(SqliteDialect))
+        .expect("a TRUNCATE checkpoint killed before its WAL truncate must stay openable");
+    let conn2 = db2
+        .connect()
+        .expect("connect should complete the checkpoint");
+    let rows = get_rows(&conn2, "SELECT count(*), min(id), max(id) FROM t");
+    assert_eq!(rows[0][0].as_int().unwrap(), 50);
+    assert_eq!(rows[0][1].as_int().unwrap(), 0);
+    assert_eq!(rows[0][2].as_int().unwrap(), 49);
+    assert_eq!(wal_path.metadata().map(|m| m.len()).unwrap_or(0), 0);
+    let ic = get_rows(&conn2, "PRAGMA integrity_check");
+    assert_eq!(ic[0][0].to_string(), "ok");
+    conn2
+        .execute("INSERT INTO t VALUES (100, 'after')")
+        .unwrap();
+    let rows = get_rows(&conn2, "SELECT count(*) FROM t");
+    assert_eq!(rows[0][0].as_int().unwrap(), 51);
+}
+
 /// MVCC supports only Passive and Truncate, so a requested FULL checkpoint maps to
 /// Truncate (resets the WAL). The reopen then recovers cleanly. Regression for whopper
 /// `--enable-mvcc` (no passive flag) hitting "WAL has committed frames but logical log
diff --git a/docs/internals/mvcc/RECOVERY_SEMANTICS.md b/docs/internals/mvcc/RECOVERY_SEMANTICS.md
index da1b696..c69d12a 100644
--- a/docs/internals/mvcc/RECOVERY_SEMANTICS.md
+++ b/docs/internals/mvcc/RECOVERY_SEMANTICS.md
@@ -43,7 +43,7 @@ Recovery classifies startup state using two checks:
 | Case | Startup artifacts | Recovery behavior |
 |---|---|---|
 | 1 | WAL has committed frames + log header valid | Complete interrupted checkpoint: backfill WAL into DB, sync DB, truncate WAL. Then run logical-log recovery with metadata cutoff. |
-| 2 | WAL has committed frames + log header missing (`NoLog`) | Fail closed with `Corrupt`. |
+| 2 | WAL has committed frames + log header missing (`NoLog`) | Complete interrupted checkpoint (as case 1), then write a fresh log header. A TRUNCATE checkpoint leaves this state when killed between steps 8 and 10; the log is only cleared once the WAL holds every frame it had. Passive checkpoints leave it as their steady state. |
 | 3 | WAL has committed frames + log header invalid/torn | Fail closed with `Corrupt`. |
 | 4 | WAL has no committed frames | Truncate/discard WAL tail bytes and continue logical-log recovery. |
 | 5 | No WAL + log header invalid/torn | Fail closed with `Corrupt`. |
diff --git a/testing/simulator/runner/memory/mvcc_recovery.rs b/testing/simulator/runner/memory/mvcc_recovery.rs
index 3177878..e0eea6c 100644
--- a/testing/simulator/runner/memory/mvcc_recovery.rs
+++ b/testing/simulator/runner/memory/mvcc_recovery.rs
@@ -264,13 +264,18 @@ fn sim_mvcc_restart_recovery_is_idempotent() -> Result<()> {
     Ok(())
 }
 
-/// What this test checks: Startup fails closed when WAL has committed state but the MVCC log file is missing.
-/// Why this matters: In uncertain durability states, refusing to open is safer than guessing and risking data loss.
+/// What this test checks: Startup completes the interrupted checkpoint when the WAL has
+/// committed state and the MVCC log is empty (this IO backend recreates a removed log as an
+/// empty file on open, so removal and truncation are the same state here).
+/// Why this matters: A TRUNCATE checkpoint leaves exactly this state when the process dies
+/// between truncating the logical log and truncating the WAL. The log is only cleared once the
+/// WAL holds every frame it had, so completing the checkpoint loses nothing; failing closed made
+/// the database impossible to open (#7480).
 #[test]
-fn sim_mvcc_fail_closed_case_wal_without_log() -> Result<()> {
+fn sim_mvcc_completes_checkpoint_case_wal_without_log() -> Result<()> {
     let seed = 203;
     let io = make_io(seed, 100);
-    let path = format!("sim_mvcc_fail_closed_missing_log_{seed}.db");
+    let path = format!("sim_mvcc_wal_without_log_{seed}.db");
 
     let conn = open_conn(io.clone(), &path)?;
     enable_mvcc(&conn)?;
@@ -278,7 +283,13 @@ fn sim_mvcc_fail_closed_case_wal_without_log() -> Result<()> {
     drop(conn);
 
     remove_file_by_suffix(io.as_ref(), ".db-log")?;
-    assert_open_fails_closed(io, &path);
+    let conn = open_conn(io.clone(), &path)?;
+    assert_eq!(query_rows(&conn, io.as_ref())?, vec![(1, "a".to_string())]);
+    conn.execute("INSERT INTO t VALUES (2, 'b')")?;
+    assert_eq!(
+        query_rows(&conn, io.as_ref())?,
+        vec![(1, "a".to_string()), (2, "b".to_string())]
+    );
     Ok(())
 }
 
