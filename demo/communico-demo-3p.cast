[0.001, "o", "\u001b[?2026h\u001b[?25l\u001b[H──\u001b[1;71H┬──\u001b[2;71H│\u001b[3;71H│\u001b[4;71H│\u001b[5;71H│\u001b[6;71H│\u001b[7;71H│\u001b[8;71H│\u001b[9;71H│\u001b[10;71H│\u001b[11;71H│\u001b[12;71H│\u001b[13;71H│\u001b[14;71H│\u001b[15;71H│\u001b[16;71H│\u001b[17;71H│\u001b[18;71H│\u001b[19;71H│\u001b[20;71H│\u001b[21;71H│\r\n\u001b[32m──\u001b[22;71H┴\u001b(B\u001b[m\u001b[1;3H0 \"alice — unmodified matrix-commander\"─────────────────────────────\u001b(B\u001b[m\u001b[1;74H1 \"bob — same client, other side\"──────────────────────────────────\u001b(B\u001b[m\u001b[32m\u001b[7m\u001b[22;3H2\u001b(B\u001b[m\u001b[32m \"the room = a Doltgres database (dolt log)\"───────────────────────┴─────────────────────────────────────────────────────────────────────\u001b[1;1H\u001b(B\u001b[m\u001b[2;70H\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\u001b[2;72H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[23;1H\u001b[K\r\n   communico — a Matrix homeserver where the database is version-controlled\u001b[K\r\n   ------------------------------------------------------------------------\u001b[K\r\n   Server storage: Doltgres. Every Matrix event lands as a Dolt COMMIT;\u001b[K\r\n   the event id a client sees is a content hash of the event itself;\u001b[K\r\n   the commit hash is the server's per-store receipt for it.\u001b[K\r\n\u001b[K\r\n   top panes: alice and bob — two unmodified matrix-commander clients\u001b[K\u001b[31;14H\u001b[1K\u001b[Chaving a conversation through this homeserver\u001b[K\r\n   this pane: the room's database — dolt.log, refreshed every 2 s\u001b[K\r\n   (a third participant will join — watch who)\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[6A\u001b[?2026l"]
