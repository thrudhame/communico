{
  "private": true,
  "name": "Communico",
  "description": "Matrix Homeserver for the rest of us",
  "exports": {
    ".": "./main.ts",
    "./setup": "./setup.ts"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check main.ts api/ tests/*.ts tests/rulebook/*.ts demo/*.ts",
    "fmt": "deno fmt",
    "dev": "deno run --env --allow-net --allow-env --allow-read --allow-write --watch main.ts",
    "start": "deno --env --allow-net --allow-env --allow-read --allow-write main.ts",
    "setup": "deno --env --allow-net --allow-env setup.ts",
    "test": "deno test --env --allow-net --allow-env --allow-read --allow-write --allow-run tests/*.ts tests/rulebook/*.ts",
    "db-init": "deno run --env --allow-net --allow-env --allow-read db/init.ts",
    "db-start": "doltgres --config /etc/doltgres/servercfg.d/config.yaml",
    "debug-proxy": "deno run --allow-env --allow-net --allow-write jsr:@thrudhame/http-debug-proxy"
  },
  "imports": {
    "#engine/": "./api/engine/",
    "#endpoints/": "./api/endpoints/",
    "#root/": "./",
    "#tests/": "./tests/",
    "@pathfinder/pathfinder": "jsr:@pathfinder/pathfinder@0.2.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/collections": "jsr:@std/collections@^1.1.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@stdext/crypto": "jsr:@stdext/crypto@^0.1.1",
    "pg": "npm:pg@^8.16.3"
  },
  "workspace": ["./api"],
  "fmt": {
    "options": {
      "singleQuote": true,
      "proseWrap": "preserve"
    },
    "exclude": ["complement/BASELINE.md", "complement/BASELINE.prev.md"]
  }
}
