{
  "private": true,
  "name": "Communico",
  "description": "Matrix Homeserver for the rest of us",
  "version": "0.1.0-dev",
  "tasks": {
    "native": "sh tools/native-build.sh",
    "check": "deno fmt --check && deno lint && deno check main.ts api/ tests/ tools/",
    "start": "deno --env --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-sys=uid,umask,ca --allow-run=openssl,gpg,gpgconf main.ts",
    "fmt": "deno fmt",
    "test": "COMMUNICO_ENCRYPTION_ALLOWUNENCRYPTEDCREATION=true COMMUNICO_ENCRYPTION_ALLOWUNENCRYPTEDJOINING=true COMMUNICO_ENCRYPTION_ALLOWUNENCRYPTEDMESSAGES=true deno test --allow-net --allow-env --allow-read --allow-write --allow-run --allow-ffi --allow-sys=uid,umask,ca tests/*.test.ts tests/rulebook/*.test.ts",
    "config": "deno run --allow-env --allow-read tools/config.ts",
    "federation-block": "sh tools/admin.sh federation-block",
    "federation-peer": "sh tools/admin.sh federation-peer",
    "federation-key": "sh tools/admin.sh federation-key",
    "federation-outbox": "sh tools/admin.sh federation-outbox",
    "federation-cert": "sh tools/admin.sh federation-cert",
    "rooms": "sh tools/admin.sh rooms",
    "backup": "sh tools/admin.sh backup",
    "restore": "deno run --env --allow-env --allow-read --allow-write --allow-ffi --allow-sys=uid --allow-run=gpg,gpgconf tools/restore.ts",
    "debug-proxy": "deno run --allow-env --allow-net --allow-write jsr:@thrudhame/http-debug-proxy"
  },
  "imports": {
    "ws": "npm:ws@8.23.0",
    "imagescript": "npm:imagescript@3.20.2",
    "parse5": "npm:parse5@8.0.0",
    "html-encoding-sniffer": "npm:html-encoding-sniffer@4.0.0",
    "whatwg-encoding": "npm:whatwg-encoding@3.1.1",
    "saxes": "npm:saxes@6.0.0",
    "typescript": "npm:typescript@5.9.3",
    "#engine/": "./api/engine/",
    "#endpoints/": "./api/endpoints/",
    "#root/": "./",
    "#tests/": "./tests/",
    "#endpoints/v3/rooms/messages": "./api/endpoints/matrix/_matrix/client/v3/rooms/%23roomId/messages/get.ts",
    "#endpoints/v3/rooms/joined_members": "./api/endpoints/matrix/_matrix/client/v3/rooms/%23roomId/joined_members/get.ts",
    "@pathfinder/pathfinder": "jsr:@pathfinder/pathfinder@0.2.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/html": "jsr:@std/html@^1",
    "@std/toml": "jsr:@std/toml@^1",
    "@stdext/crypto": "jsr:@stdext/crypto@^0.1.1"
  },
  "workspace": ["./api"],
  "fmt": {
    "options": {
      "singleQuote": true,
      "proseWrap": "preserve"
    },
    "exclude": ["complement/BASELINE.md", "complement/BASELINE.prev.md"]
  }
}
